# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
INVITE_CODE=
STOCK_FIGHT_PORT=8080
STOCK_FIGHT_BIND=0.0.0.0
STOCK_FIGHT_DEV_HOST=127.0.0.1
SESSION_COOKIE_SECURE=0
AUTO_SEED_HISTORICAL=1
AUTO_SEED_DEMO=1
ALLOW_SYNTHETIC=1
MARKET_TICK_SECONDS=3
MATCH_PREVIEW_BARS=12
# For local use with Render Postgres, set the External Database URL.
# DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require
